rules_version = '2';
// 사용자 문서는 users/{uid} 하나. 본인만 만들고 읽고 고치고 지울 수 있다.
// 목록 조회는 아래 관리자 이메일로 로그인한 경우(admin.html)에만 허용하고, 관리자도 남의 문서를 고치거나 지울 수는 없다.
// Firebase 콘솔 접근은 이 규칙의 영향을 받지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== 관리자 이메일 목록 (admin.html의 ADMIN_EMAILS와 같게 유지) =====
    // 구글 계정 이메일을 소문자로 넣는다. 바꾼 뒤 Firebase 콘솔 → Firestore → 규칙에 다시 게시해야 적용된다.
    function adminEmails() {
      return ['REPLACE_WITH_ADMIN_EMAIL'];
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in adminEmails();
    }

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile(d) {
        return d.keys().hasOnly(['uid', 'email', 'displayName', 'channelName', 'channelUrl', 'platform',
                                 'consentVersion', 'consentAt', 'createdAt', 'lastLoginAt'])
          && d.uid == uid
          && d.email == request.auth.token.email
          && d.displayName is string && d.displayName.size() <= 100
          && d.channelName is string && d.channelName.size() >= 1 && d.channelName.size() <= 100
          && d.channelUrl is string && d.channelUrl.size() <= 300
          && (d.channelUrl == '' || d.channelUrl.matches('https?://.+'))
          && d.platform in ['youtube', 'instagram', 'tiktok', 'chzzk', 'afreeca', 'naver', 'other', '']
          && d.consentVersion is string && d.consentVersion.size() <= 20
          && d.consentAt is timestamp
          && d.createdAt is timestamp
          && d.lastLoginAt is timestamp;
      }

      // 본인은 자기 문서만, 관리자는 전체 조회(읽기 전용)
      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner()
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.consentAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if isOwner()
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uid == resource.data.uid
        && (request.resource.data.consentAt == resource.data.consentAt || request.resource.data.consentAt == request.time)
        && request.resource.data.lastLoginAt == request.time;
      allow delete: if isOwner();
    }
  }
}
